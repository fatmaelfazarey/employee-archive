{
    "name": "employee-system",
    "version": "1.0.0",
    "description": "Arabic Employee Archive System with SQLite and Excel",
    "main": "src/main/main.js",
    "author": "Your Name",
    "license": "MIT",
  "scripts": {
  "start": "electron .",
  "dev": "electronmon .",
  "rebuild": "electron-rebuild -f -w better-sqlite3",
  "postinstall": "electron-rebuild -f -w better-sqlite3",
  "test:db": "set ELECTRON_RUN_AS_NODE=1&& electron tests/db.test.js",
  "build:win": "electron-builder --win portable",
  "sync:fields": "node -e \"const fs=require('fs');const s=fs.readFileSync('src/shared/fields.js','utf8');const b='// auto-generated\\n(function(){const module={exports:{}};const exports=module.exports;'+s+'\\nwindow.FIELDS_MODULE=module.exports;})();';fs.writeFileSync('src/renderer/js/fields-bundle.js',b);console.log('fields-bundle.js updated');\""
},
    "dependencies": {
        "better-sqlite3": "^12.4.1",
        "exceljs": "^4.4.0"
    },
    "devDependencies": {
        "@electron/rebuild": "^3.7.1",
        "electron": "^38.0.0",
        "electron-builder": "^25.1.8",
        "electronmon": "^2.0.4"
    },
    "build": {
        "appId": "com.example.employee-system",
        "productName": "EmployeeSystem",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "node_modules/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "portable": {
            "artifactName": "EmployeeSystem.exe",
            "requestExecutionLevel": "user",
            "unpackDirName": false
        }
    }
}
